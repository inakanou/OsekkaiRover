# おせっかいローバーの新しい基盤（systemd のユーザーサービス）
#
# 置き場所（device-deployment の道具が作る）:
#   - 今の版へのリンク: ~/osekkai-rover/current（版ごとのディレクトリを指す）
#   - 仮想環境: ~/osekkai-rover/current/.venv（版ごとに --system-site-packages で作る）
# 道具は、このファイルを今の版から ~/.config/systemd/user/ に写して読み直す。
# サンプル（~/works/OsekkaiRover、osekkai-rover.service）とは別の名前と場所に置く。

[Unit]
Description=Osekkai Rover core
# 声を出すので、再生のサービスの後に起動する
After=pipewire-pulse.service
Wants=pipewire-pulse.service
# サンプルのユニットとは同時に動かさない（片方を起動すると、もう片方は止まる）
Conflicts=osekkai-rover.service

[Service]
Type=simple
# 版のディレクトリに editable（pip install -e）で入れた版を、そのディレクトリで動かす
WorkingDirectory=%h/osekkai-rover/current
ExecStart=%h/osekkai-rover/current/.venv/bin/python -m osekkai
Environment=PYTHONUNBUFFERED=1

# 停止: SIGTERM は本体だけに送る。本体はモーターを止め、首を戻してから終える。
# 15 秒で終わらなければ、残りのプロセスごと SIGKILL する。
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15s

# どんな終わり方（kill -9 も）の後でも、モーターの PWM を 0 にする。
# 道具は止めてから current を切り替えるので、止めた版の安全停止が動く。
ExecStopPost=%h/osekkai-rover/current/.venv/bin/python -m osekkai.core.safe_stop

# 異常終了（終了コード 1 など）では 5 秒後に起動し直す。
# 75 はすでに動いているときなので、起動し直さない。
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=75

[Install]
WantedBy=default.target
