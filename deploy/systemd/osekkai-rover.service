# おせっかいローバーの本体（systemd のユーザーサービス）
#
# 置き場所の前提（device-deployment で確かめる）:
#   - 実機の作業コピー: ~/works/OsekkaiRover
#   - 仮想環境: ~/works/OsekkaiRover/.venv（--system-site-packages で作る）
# 違う場所に置くときは、WorkingDirectory と 2 つの python のパスを合わせて変える。
# 登録・有効化・リンガリングは device-deployment の初期設定で行う。

[Unit]
Description=Osekkai Rover core

[Service]
Type=simple
# 作業コピーに editable（pip install -e）で入れた版を、作業コピーで動かす
WorkingDirectory=%h/works/OsekkaiRover
ExecStart=%h/works/OsekkaiRover/.venv/bin/python -m osekkai
Environment=PYTHONUNBUFFERED=1

# 停止: SIGTERM は本体だけに送る。本体はモーターを止め、首を戻してから終える。
# 15 秒で終わらなければ、残りのプロセスごと SIGKILL する。
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15s

# どんな終わり方（kill -9 も）の後でも、モーターの PWM を 0 にする
ExecStopPost=%h/works/OsekkaiRover/.venv/bin/python -m osekkai.core.safe_stop

# 異常終了（終了コード 1 など）では 5 秒後に起動し直す。
# 75 はすでに動いているときなので、起動し直さない。
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=75

[Install]
WantedBy=default.target
